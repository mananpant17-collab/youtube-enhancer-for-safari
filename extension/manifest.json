{
  "manifest_version": 3,
  "name": "YouTube Enhancer for Safari",
  "version": "0.7.0",
  "description": "Pinch-to-change-speed, Hide Shorts and player enhancements for YouTube in Safari.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "YouTube Enhancer",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/gesture-speed.js",
        "src/speed-policy.js",
        "src/features.js",
        "src/bar-logic.js",
        "src/indicator.js",
        "src/controlbar.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "css": [
        "css/youtube.css"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
